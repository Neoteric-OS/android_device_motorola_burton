java_library {
    name: "com.motorola.motosignature",
    srcs: ["src/**/*.java"],
    installable: true,
    system_ext_specific: true,
    sdk_version: "current",
    required: ["com.motorola.motosignature.xml"],
}

prebuilt_etc {
    name: "com.motorola.motosignature.xml",
    src: "com.motorola.motosignature.xml",
    sub_dir: "permissions",
    system_ext_specific: true,
}
