cc_binary {
    name: "android.hardware.sensors-service.burton-multihal",
    vendor: true,
    relative_install_path: "hw",
    srcs: [
        "ConvertUtils.cpp",
        "HalProxy.cpp",
        "HalProxyAidl.cpp",
        "HalProxyCallback.cpp",
        "service.cpp",
    ],
    local_include_dirs: ["include"],
    init_rc: ["android.hardware.sensors-service.burton-multihal.rc"],
    vintf_fragment_modules: ["android.hardware.sensors-multihal.xml"],
    cflags: ["-DLOG_TAG=\"SensorsMultiHal\""],
    header_libs: [
        "android.hardware.sensors@2.X-multihal.header",
        "android.hardware.sensors@2.X-shared-utils",
    ],
    shared_libs: [
        "android.hardware.sensors-V3-ndk",
        "android.hardware.sensors@1.0",
        "android.hardware.sensors@2.0",
        "android.hardware.sensors@2.0-ScopedWakelock",
        "android.hardware.sensors@2.1",
        "libbase",
        "libbinder_ndk",
        "libcutils",
        "libfmq",
        "libhidlbase",
        "liblog",
        "libpower",
        "libutils",
    ],
    static_libs: [
        "android.hardware.sensors@1.0-convert",
        "libaidlcommonsupport",
    ],
}
