prebuilt_etc {
    name: "fstab.qcom",
    src: "fstab.qcom",
    vendor: true,
}

prebuilt_etc {
    name: "init.target.rc",
    src: "init.target.rc",
    sub_dir: "init/hw",
    vendor: true,
}

prebuilt_etc {
    name: "ueventd.motorola.rc",
    filename: "ueventd.rc",
    src: "ueventd.motorola.rc",
    device_specific: true,
}

prebuilt_etc {
    name: "init.burton.debug.rc",
    src: "init.burton.debug.rc",
    sub_dir: "init",
    system_ext_specific: true,
}

sh_binary {
    name: "init.qti.dcvs.sh",
    src: "init.qti.dcvs.sh",
    vendor: true,
}
